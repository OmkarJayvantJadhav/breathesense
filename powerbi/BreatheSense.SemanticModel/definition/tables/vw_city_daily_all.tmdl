	column 'Median AQI Category Order' = VAR a = ROUND ( vw_city_daily_all[Median Station AQI], 0 ) RETURN SWITCH ( TRUE (), ISBLANK ( a ), 7, a <= 50, 1, a <= 100, 2, a <= 200, 3, a <= 300, 4, a <= 400, 5, 6 )
		formatString: 0
		lineageTag: 5c792f8a-3fac-47bd-ab16-0e46d328a20f
		summarizeBy: none

	column 'Median AQI Category Label' = IF ( ISBLANK ( vw_city_daily_all[Median AQI Category] ), "Insufficient data", vw_city_daily_all[Median AQI Category] )
		lineageTag: ba217c48-75e4-429b-a603-bb554a99daed
		summarizeBy: none
		sortByColumn: 'Median AQI Category Order'

	column 'Dominant Pollutant Label' = SWITCH ( vw_city_daily_all[Dominant Pollutant], "pm25", "PM2.5", "pm10", "PM10", "no2", "NO₂", "so2", "SO₂", "o3", "O₃", "co", "CO", "nh3", "NH₃", "pb", "Pb", "Not determined" )
		lineageTag: bb401665-533a-48db-8647-83b1bbdc8f40
		summarizeBy: none

