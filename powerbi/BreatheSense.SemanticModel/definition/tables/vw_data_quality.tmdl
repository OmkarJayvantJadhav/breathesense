table vw_data_quality
	lineageTag: fd9a4389-4439-45ce-b02e-5d1246d6fc95

	measure 'Fresh Stations' = COALESCE ( CALCULATE ( COUNTROWS ( vw_data_quality ), vw_data_quality[Is Fresh] = TRUE () ), 0 )
		formatString: 0
		lineageTag: 66b0bf59-9fab-45c8-ad0a-c2498ae80aff

	measure 'Stale Stations' = COALESCE ( CALCULATE ( COUNTROWS ( vw_data_quality ), vw_data_quality[Is Fresh] = FALSE () ), 0 )
		formatString: 0
		lineageTag: 1f353c99-1c27-493d-a7e4-ebf58fe9bc43

	measure 'Data Completeness %' =
			// average share of the last 24 hours with data, across the selected stations
			DIVIDE ( AVERAGE ( vw_data_quality[Completeness % (24h)] ), 100 )
		formatString: 0.0%
		lineageTag: 83ddb1db-898c-4c29-b458-090fa28901b6

	column 'Location ID'
		dataType: int64
		formatString: 0
