	partition vw_data_quality = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("ep-dark-moon-b3ti6gml.c-4.ap-southeast-1.aws.neon.tech:5432", "neondb"),
				    View = Source{[Schema="public",Item="vw_data_quality"]}[Data],
				    Typed = Table.TransformColumnTypes(View, {{"Location ID", Int64.Type}, {"Station", type text}, {"City", type text}, {"State", type text}, {"Provider", type text}, {"Gas Unit Convention", type text}, {"Last Stored Hour (IST)", type datetime}, {"Hours Since Last Data", type number}, {"Is Fresh", type logical}, {"Hours With Data (24h)", Int64.Type}, {"Completeness % (24h)", type number}, {"Low Coverage Hours (24h)", Int64.Type}, {"Live Pollutant Sensors", type text}, {"Pollutants Missing (24h)", type text}})
				in
				    Typed

	annotation PBI_NavigationStepName = Navigation

