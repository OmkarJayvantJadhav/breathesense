table vw_location_aqi_now
	lineageTag: b2365691-f2f0-402e-8915-1b2e7b2ca20f

	measure 'Current Station AQI' =
			IF (
			    HASONEVALUE ( vw_location_aqi_now[Station] ),
			    MAX ( vw_location_aqi_now[BreatheSense AQI] ),
			    BLANK ()
			)
		formatString: 0
		lineageTag: 5aff54b1-d243-4a3d-a953-bb6cb7d9249c

	measure 'Median Station AQI' = MEDIAN ( vw_location_aqi_now[BreatheSense AQI] )
		formatString: 0
		lineageTag: f05b1e8f-2fcc-4c5c-97d4-6b3697787722

	measure 'Max Station AQI' = MAX ( vw_location_aqi_now[BreatheSense AQI] )
		formatString: 0
		lineageTag: e64966d5-c55e-44bd-8863-605747647c72

	measure 'Avg AQI 24h' =
			// mean of station AQIs, each already based on its trailing 24 h / 8 h windows
			AVERAGE ( vw_location_aqi_now[BreatheSense AQI] )
		formatString: 0
		lineageTag: b778483e-7805-444e-9bd3-2cc9a33d0d3e

	measure 'AQI Category Color' =
			// conditional-format helper; use on the median or on a single station
			VAR v = [Median Station AQI]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( v ), "#BFBFBF",
			        v <= 50, "#00B050",
			        v <= 100, "#92D050",
			        v <= 200, "#FFFF00",
			        v <= 300, "#FF9900",
			        v <= 400, "#FF0000",
			        "#C00000"
			    )
		lineageTag: 7ca20d4e-a396-40a4-b782-776ede0d577f

	column 'Location ID'
		dataType: int64
		formatString: 0
		lineageTag: 5aa8c188-3c1d-4ecf-904b-011f65bc82b2
		summarizeBy: none
		sourceColumn: Location ID

