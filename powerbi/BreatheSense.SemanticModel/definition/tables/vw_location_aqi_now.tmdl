	column 'AQI Category Order' = VAR a = ROUND ( vw_location_aqi_now[BreatheSense AQI], 0 ) RETURN SWITCH ( TRUE (), ISBLANK ( a ), 7, a <= 50, 1, a <= 100, 2, a <= 200, 3, a <= 300, 4, a <= 400, 5, 6 )
		formatString: 0
		lineageTag: a5c5417b-0491-494d-8799-ba52d81f75c7
		summarizeBy: none

	column 'AQI Category Label' = IF ( ISBLANK ( vw_location_aqi_now[AQI Category] ), "Insufficient data", vw_location_aqi_now[AQI Category] )
		lineageTag: 3b167d2d-18a1-4fd6-8564-8840774454fe
		summarizeBy: none
		sortByColumn: 'AQI Category Order'

	column 'Dominant Pollutant Label' = SWITCH ( vw_location_aqi_now[Dominant Pollutant], "pm25", "PM2.5", "pm10", "PM10", "no2", "NO₂", "so2", "SO₂", "o3", "O₃", "co", "CO", "nh3", "NH₃", "pb", "Pb", "Not determined" )
		lineageTag: d5d13a78-83da-447d-864a-8ed01b65cbad
		summarizeBy: none

